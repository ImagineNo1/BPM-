{
  "name": "bpm-studio",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:api": "npm --workspace @bpm-studio/api run start:dev",
    "build": "next build",
    "build:web": "next build",
    "build:api": "npm --workspace @bpm-studio/api run build",
    "build:packages": "npm --workspace @bpm-studio/shared run build && npm --workspace @bpm-studio/form-engine run build && npm --workspace @bpm-studio/workflow-engine run build && npm --workspace @bpm-studio/api-generator run build && npm --workspace @bpm-studio/document-engine run build",
    "start": "next start",
    "lint": "eslint",
    "lint:api": "npm --workspace @bpm-studio/api run lint",
    "db:seed": "npm --workspace @bpm-studio/api run db:seed"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "reactflow": "^11.11.4",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
